# ── Justflows production environment ─────────────────────────────────────────
# Copy this file to `.env` in the repository root (next to package.json).
# Generate APP_SECRET with: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# The public URL of your site (no trailing slash)
APP_URL=https://yourdomain.com

# Generate a long random secret:
#   openssl rand -base64 48
# or visit: https://generate-secret.vercel.app/64
APP_SECRET=replace-this-with-a-long-random-string

# Which reverse proxies may supply the client IP and original protocol.
# Default: loopback (nginx/Apache/Passenger on this host). For direct Node use
# false. For a remote proxy use its exact IP/CIDR; never use true on a public
# host. See docs/SELF-HOSTING-SECURITY.md.
# TRUST_PROXY=loopback
# Use false for direct Node, or explicit proxy IPs/CIDRs. Hop counts and true are refused.

# Database password (used internally between containers)
DB_PASSWORD=choose-a-strong-database-password

# MySQL / MariaDB only — root password for the database container
# DB_ROOT_PASSWORD=choose-a-strong-root-password

# Port your site is served on (default 3000)
PORT=3000

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Optional writable paths. Keep them outside a public document root.
# STORAGE_LOCAL_PATH=./uploads
# PRIVATE_STORAGE_PATH=./storage/private
# CACHE_DIR=./.cache
# PACKAGES_DIR=./packages-installed
# CSS_PROVIDERS_INSTALL_DIR=./css-providers-installed

# ── Database TLS ─────────────────────────────────────────────────────────────
# On by default for any non-localhost DB_HOST. Only override if you know why.
# DB_SSL=1

# ── Package & update hardening ───────────────────────────────────────────────
# Uploaded plugins, themes, CSS providers, and core updates run in-process.
#
# Package and core update signature checks are ON by default — nothing to set here.
# Do NOT set JUSTFLOWS_ALLOW_UNSIGNED_PACKAGES or
# JUSTFLOWS_ALLOW_UNSIGNED_CORE_UPDATES on a public host.

# Allow specific .jfpkg archives by package id and SHA-256 digest (comma-separated)
# JUSTFLOWS_TRUSTED_PACKAGE_DIGESTS=acme.my-plugin:abc123...

# Pin core update .zip to an expected SHA-256 digest of the full archive
# JUSTFLOWS_UPDATE_DIGEST=

# Accept your own core builds signed with HMAC-SHA256.
# Send via X-Justflows-Update-Signature header or upload body signature field.
# JUSTFLOWS_UPDATE_SIGNING_KEY=

# Set to disable unattended core and plugin/theme auto-updates entirely.
# JUSTFLOWS_DISABLE_AUTO_UPDATE=1

# ── Static / edge export ────────────────────────────────────────────────────
# Serve high-traffic public pages from object storage / a CDN. See
# docs/STATIC-EXPORT.md. Off unless you run an export. Editable from
# Admin → System → Tools → Static site export.
# Canonical tags and sitemap.xml URLs come from APP_URL above — set that to the
# public origin; STATIC_EXPORT_BASE_URL only needs to be set when it must differ.
# STATIC_EXPORT_ENABLED=1        # 0 disables the Run actions + auto-rebuild
# STATIC_EXPORT_DIR=/var/www/static-export
# STATIC_EXPORT_BASE_URL=https://yourdomain.com
# Only for a pure-static host: exported pages fetch() form submits to this origin.
# STATIC_EXPORT_ORIGIN_URL=https://app.yourdomain.com
# STATIC_EXPORT_ALLOWED_ORIGINS=https://www.yourdomain.com
# STATIC_EXPORT_MAX_PAGES=2000
# STATIC_EXPORT_CONCURRENCY=4
# Rebuild automatically after content/menu/theme/settings changes
# (requires CACHE_REVALIDATE_ENABLED=1):
# STATIC_EXPORT_AUTO=1
# STATIC_EXPORT_DEBOUNCE_MS=5000
