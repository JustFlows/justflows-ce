<%
  const hdr = typeof header === 'undefined' || !header
    ? { visible: true, showLogo: true, showTitle: true, layout: 'logo-left', mobileLayout: 'logo-left', sticky: true, background: '' }
    : header;
  const brand = typeof headerBrand !== 'undefined' && headerBrand
    ? headerBrand
    : { showLogo: hdr.showLogo !== false && identity.logoUrl, showTitle: hdr.showTitle !== false };
%>
<% if (hdr.visible !== false) { %>
<%
  const layoutClass = hdr.layout === 'logo-center' ? ' site-header--center' : hdr.layout === 'split' ? ' site-header--split' : '';
  const stickyClass = hdr.sticky === false ? ' site-header--static' : '';
  const headerStyle = hdr.background ? `background: ${hdr.background};` : '';
  const showLogo = brand.showLogo;
  const showTitle = brand.showTitle;
  const mobileLayout = ['logo-left', 'logo-center', 'hamburger-logo', 'hamburger-only'].indexOf(hdr.mobileLayout) !== -1
    ? hdr.mobileLayout : 'logo-left';
  const brandHref = typeof localePath === 'function' ? localePath(locale, '/', defaultLocale) : '/';
  // Brand markup, reused inside the mobile menu for the `hamburger-only` layout.
  // Built as a string, so every interpolated value must be HTML-escaped here.
  const _esc = function (s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  };
  const brandInner =
    (showLogo ? '<img class="site-logo" src="' + _esc(identity.logoUrl) + '" alt="' + (showTitle ? '' : _esc(identity.siteTitle)) + '">' : '') +
    (showTitle ? '<span class="site-brand-text">' + _esc(identity.siteTitle) + '</span>' : '');
  const mobileBrandHtml = mobileLayout === 'hamburger-only'
    ? '<a href="' + _esc(brandHref) + '" class="site-brand site-brand--in-menu">' + brandInner + '</a>'
    : '';
  // Rearrange the bar below the menu's breakpoint. Emitting it here (not in
  // global.css) because the breakpoint is the menu design's, which varies.
  const mBp = (function () {
    const raw = typeof menuDesign !== 'undefined' && menuDesign ? Number(menuDesign.breakpoint) : 768;
    return Math.max(320, Math.min(1400, raw || 768));
  })();
%>
<% if (mobileLayout !== 'logo-left') { %>
  <%
    // Below the menu's breakpoint the hamburger is lifted to the LEFT edge with
    // `position: absolute` (no `display: contents`, which proved fragile), and
    // the inner reserves room for it. The brand is then centred / kept beside it
    // / hidden per layout. `#primary-toggle` here is the same element the menu
    // partial renders inside `.site-nav`.
    const mSel = '.site-header--m-' + mobileLayout;
  %>
  <style>
    @media (max-width: <%= mBp %>px) {
      <%= mSel %> .site-header-inner { position: relative; padding-left: 3.6rem; }
      <%= mSel %> #primary-toggle {
        position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%);
        margin: 0; z-index: 3;
      }
      <% if (mobileLayout === 'logo-center') { %>
        <%= mSel %> .site-header-inner { justify-content: flex-end; }
        <%= mSel %> .site-brand {
          position: absolute; left: 50%; transform: translateX(-50%);
          margin: 0; max-width: 60vw; text-align: center;
        }
        <%= mSel %> .site-brand .site-logo { height: 28px; }
      <% } else if (mobileLayout === 'hamburger-logo') { %>
        <%= mSel %> .site-brand { margin-right: auto; }
      <% } else if (mobileLayout === 'hamburger-only') { %>
        <%= mSel %> .site-header-inner { justify-content: flex-end; }
        <%= mSel %> > .site-header-inner > .site-brand { display: none; }
      <% } %>
    }
  </style>
<% } %>
<header class="site-header site-header--m-<%= mobileLayout %><%= layoutClass %><%= stickyClass %>"<% if (headerStyle) { %> style="<%= headerStyle %>"<% } %>>
  <div class="site-header-inner">
    <a href="<%= brandHref %>" class="site-brand"<% if (!showTitle) { %> aria-label="<%= identity.siteTitle %>"<% } %>>
      <% if (showLogo) { %>
        <img class="site-logo" src="<%= identity.logoUrl %>" alt="<%= showTitle ? '' : identity.siteTitle %>">
      <% } %>
      <% if (showTitle) { %>
        <span class="site-brand-text"><%= identity.siteTitle %></span>
      <% } %>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <%- include('nav-menu', {
        items: typeof navItems !== 'undefined' ? navItems : [],
        menuDesign: typeof menuDesign !== 'undefined' ? menuDesign : undefined,
        menuId: 'primary',
        currentPath: typeof publicPath !== 'undefined' ? publicPath : '',
        t: typeof t === 'function' ? t : undefined,
        mobileBrandHtml: mobileBrandHtml,
      }) %>
      <% if (hdr.showLanguageSwitcher !== false && typeof languageLinks !== 'undefined' && languageLinks.length > 1) { %>
        <span class="site-lang jf-language-switcher jf-language-switcher--<%= hdr.languageSwitcherStyle || 'locale-short' %>" data-jf-widget="language-switcher" data-jf-style="<%= hdr.languageSwitcherStyle || 'locale-short' %>">
          <%
            const langStyle = hdr.languageSwitcherStyle || 'locale-short';
            const currentLanguage = languageLinks.find(function(lang) { return lang.current; }) || languageLinks[0];
            const languageLabel = function(lang) {
              const langLabel = langStyle === 'locale-full' ? lang.code
                : langStyle === 'flags' ? lang.flag
                  : langStyle === 'flag-locale' ? lang.flag + ' ' + lang.shortCode
                    : langStyle === 'flag-country' ? lang.flag + ' ' + lang.countryName
                      : lang.shortCode;
              return langLabel;
            };
          %>
          <details class="jf-language-switcher__dropdown">
            <summary class="jf-language-switcher__trigger"<% if (langStyle === 'flags') { %> aria-label="<%= currentLanguage.name || currentLanguage.code %>"<% } %>>
              <span><%= languageLabel(currentLanguage) %></span><span class="jf-language-switcher__chevron" aria-hidden="true">⌄</span>
            </summary>
            <span class="jf-language-switcher__menu">
              <% languageLinks.forEach(function(lang) { %>
                <a href="<%= lang.href %>" class="site-lang__link jf-language-switcher__link<%= lang.current ? ' is-current' : '' %>" hreflang="<%= lang.code %>" lang="<%= lang.code %>"<% if (langStyle === 'flags') { %> aria-label="<%= lang.name || lang.code %>"<% } %><% if (lang.current) { %> aria-current="page"<% } %>><%= languageLabel(lang) %></a>
              <% }); %>
            </span>
          </details>
        </span>
      <% } %>
      <% if (hdr.showColorScheme) { %>
        <%
          const schemeLabel = (key, fallback) => typeof t === 'function' ? t('color_scheme.' + key) : fallback;
          const schemeModes = [['light', '☀', schemeLabel('light', 'Light')], ['dark', '☾', schemeLabel('dark', 'Dark')]];
          if (hdr.showColorSchemeSystem) schemeModes.push(['system', '◐', schemeLabel('system', 'Auto')]);
        %>
        <div class="jf-color-scheme jf-color-scheme--icons" data-jf-widget="color-scheme" data-jf-style="icons">
          <% schemeModes.forEach(function(mode) { %>
            <button type="button" class="jf-color-scheme__btn" data-jf-theme="<%= mode[0] %>" aria-pressed="false" aria-label="<%= mode[2] %>">
              <span class="jf-color-scheme__icon" aria-hidden="true"><%= mode[1] %></span>
              <span class="jf-color-scheme__label"><%= mode[2] %></span>
            </button>
          <% }); %>
        </div>
      <% } %>
      <% if (hdr.showAuthLinks) { %>
        <nav class="jf-auth-links jf-auth-links--buttons" aria-label="Account">
          <a href="/login" class="btn btn--outline"><%= typeof t === 'function' ? t('auth.login') : 'Log in' %></a>
          <% if (typeof usersCanRegister !== 'undefined' && usersCanRegister) { %>
            <a href="/register" class="btn btn--primary"><%= typeof t === 'function' ? t('auth.register') : 'Register' %></a>
          <% } %>
        </nav>
      <% } %>
      <% if (typeof headerBlocksHtml !== 'undefined' && headerBlocksHtml) { %>
        <div class="site-header-blocks"><%- headerBlocksHtml %></div>
      <% } %>
    </nav>
  </div>
</header>
<% } %>
