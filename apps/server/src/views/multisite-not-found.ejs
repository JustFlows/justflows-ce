<!doctype html>
<html lang="<%= locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <title><%= title %></title>
  <style>
    :root {
      color-scheme: light dark;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f5f7fb;
      color: #172033;
    }
    * { box-sizing: border-box; }
    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 2rem;
      background:
        radial-gradient(circle at 20% 10%, rgba(79, 70, 229, 0.10), transparent 32rem),
        #f5f7fb;
    }
    main {
      width: min(100%, 42rem);
      padding: clamp(2rem, 6vw, 4.5rem);
      border: 1px solid #e2e7f0;
      border-radius: 1.5rem;
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 1.5rem 4rem rgba(30, 41, 59, 0.10);
      text-align: center;
    }
    .status {
      display: inline-flex;
      align-items: center;
      min-height: 2rem;
      margin-bottom: 1.5rem;
      padding: 0.35rem 0.8rem;
      border-radius: 999px;
      background: #eef2ff;
      color: #4338ca;
      font-size: 0.78rem;
      font-weight: 750;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .system-page-content > :first-child { margin-top: 0; }
    .system-page-content > :last-child { margin-bottom: 0; }
    h1, h2, h3 {
      margin: 0 0 1rem;
      color: #111827;
      font-size: clamp(2.25rem, 8vw, 4.25rem);
      line-height: 1.02;
      letter-spacing: -0.045em;
    }
    p {
      max-width: 34rem;
      margin: 0 auto 1.75rem;
      color: #667085;
      font-size: 1.08rem;
      line-height: 1.7;
    }
    a { color: inherit; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0.75rem 1.15rem;
      border-radius: 0.75rem;
      background: #111827;
      color: #fff;
      font-weight: 700;
      text-decoration: none;
      transition: transform 120ms ease, background 120ms ease;
    }
    .btn:hover { background: #30394a; transform: translateY(-1px); }
    .btn:focus-visible { outline: 3px solid #818cf8; outline-offset: 3px; }
    img, video { max-width: 100%; height: auto; border-radius: 0.9rem; }
    ul, ol { width: fit-content; margin: 1rem auto; text-align: left; }
    @media (prefers-color-scheme: dark) {
      :root { background: #0d111b; color: #e5e7eb; }
      body {
        background:
          radial-gradient(circle at 20% 10%, rgba(99, 102, 241, 0.18), transparent 32rem),
          #0d111b;
      }
      main { border-color: #263043; background: rgba(18, 24, 38, 0.96); box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.35); }
      .status { background: #252752; color: #c7d2fe; }
      h1, h2, h3 { color: #f8fafc; }
      p { color: #aeb8ca; }
      .btn { background: #f8fafc; color: #111827; }
      .btn:hover { background: #dfe5ee; }
    }
  </style>
</head>
<body>
  <main>
    <div class="status" aria-hidden="true">404</div>
    <div class="system-page-content"><%- bodyHtml %></div>
  </main>
</body>
</html>
