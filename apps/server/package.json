{
  "name": "@justflows/server",
  "version": "0.1.5",
  "private": true,
  "description": "Justflows — unified Express server (API + admin + public site)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:admin": "vite --config admin-ui/vite.config.ts",
    "dev:public-scripts": "node public-scripts/copy-vendor.mjs && node public-scripts/build.mjs --watch",
    "build": "npm run build:public-scripts && npm run build:admin-ui && npm run build:server",
    "build:server": "tsc -p tsconfig.json && rm -rf dist/views && cp -r src/views dist/views && mkdir -p dist/lib/i18n && rm -rf dist/lib/i18n/site-catalogs dist/lib/i18n/admin-catalogs && cp -r src/lib/i18n/site-catalogs src/lib/i18n/admin-catalogs dist/lib/i18n/",
    "build:admin-ui": "vite build --config admin-ui/vite.config.ts && vite build --config admin-ui/vite.ssr.config.ts",
    "build:public-scripts": "NODE_ENV=production node public-scripts/build.mjs && node public-scripts/copy-vendor.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p public-scripts/tsconfig.json --noEmit && pnpm typecheck:tests",
    "test": "vitest run && vitest run --config admin-ui/vitest.config.ts",
    "clean": "rm -rf dist admin-ui/dist ../../public/js/*.js",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@justflows/blocks": "file:../../packages/blocks",
    "@justflows/cache": "file:../../packages/cache",
    "@justflows/content": "file:../../packages/content",
    "@justflows/core": "file:../../packages/core",
    "@justflows/installer": "file:../../packages/installer",
    "@justflows/jobs": "file:../../packages/jobs",
    "@justflows/media": "workspace:*",
    "@justflows/plugin-api": "file:../../packages/plugin-api",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "katex": "^0.19.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "undici": "8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "framer-motion": "^14.6.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-compiler": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
