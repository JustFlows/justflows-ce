{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@components/*": ["admin-ui/src/components/*"],
      "@lib/*": ["src/lib/*"]
    }
  },
  "include": ["admin-ui/src/**/*.ts", "admin-ui/src/**/*.tsx"]
}
