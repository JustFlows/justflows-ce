# Every npm-run script (install:all, install:production, build:server, …)
# shells out to run its command string. Without this, that subshell only sees
# the host's general PATH, not the directory of the npm/node binary that
# launched it — on hosts where a node version manager (nodenv, nvm) has no
# version selected for this directory, "npm install" itself can still work
# (the launcher resolves npm directly) while every script's own bare `node`
# invocation fails with "command not found" even though node is installed.
scripts-prepend-node-path=true
