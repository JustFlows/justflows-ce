              "props": {
                "html": "<div class=\"jf-stats\"><div class=\"jf-stat\"><strong>50+</strong><span>Core blocks</span></div><div class=\"jf-stat\"><strong>100%</strong><span>Self-hosted</span></div><div class=\"jf-stat\"><strong>0</strong><span>Vendor lock-in</span></div><div class=\"jf-stat\"><strong>∞</strong><span>Pages you can build</span></div></div>"
              }
            }
          ]
        }
      ]
