        {
          "id": "home-logos-inner",
          "type": "core.container",
          "version": 1,
          "props": { "width": "wide" },
          "children": [
            {
              "id": "home-logos-html",
              "type": "core.html",
              "version": 1,
              "props": {
                "html": "<p class=\"jf-logos__label\">Trusted by teams who ship fast</p><div class=\"jf-logos\"><span>Acme</span><span>Nova</span><span>Pixel</span><span>Orbit</span><span>Lumen</span></div>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "home-features",
      "type": "core.features",
      "version": 1,
      "props": {
        "heading": "Everything you need to launch",
        "columns": 3,
        "items": [
          { "icon": "⚡", "title": "Blazing fast", "description": "Server-rendered pages with minimal JavaScript on the public site." },
          { "icon": "🧱", "title": "Block builder", "description": "Drag sections, columns, heroes, and CTAs — WordPress-like, but cleaner." },
          { "icon": "🎨", "title": "Theme customizer", "description": "Colors, fonts, and layout tokens without touching code." },
          { "icon": "🌍", "title": "Multilingual", "description": "Locale-aware URLs, translations, and language switcher built in." },
          { "icon": "🔒", "title": "Self-hosted", "description": "Your content stays on your server. No SaaS lock-in." },
          { "icon": "📦", "title": "Extensible", "description": "Themes and plugins via packages — grow when you're ready." }
        ]
      }
    },
    {
      "id": "home-stats",
      "type": "core.section",
      "version": 1,
      "props": { "background": "gradient", "padding": "lg", "align": "center" },
