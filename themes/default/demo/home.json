{
  "title": "Demo homepage",
  "blocks": [
    {
      "id": "home-hero",
      "type": "core.hero",
      "version": 1,
      "props": {
        "heading": "Build beautiful pages without the bloat",
        "subheading": "Justflows is a clean, self-hosted CMS with a visual page builder, theme customizer, and block-based content — everything you need, nothing you don't.",
        "buttonLabel": "Open admin",
        "buttonUrl": "/admin",
        "backgroundImage": "",
        "align": "center"
      }
    },
    {
      "id": "home-logos",
      "type": "core.section",
      "version": 1,
      "props": { "background": "muted", "padding": "md", "align": "center" },
