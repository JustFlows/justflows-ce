{
  "id": "justflows.funky",
  "name": "Funky",
  "version": "1.0.0-dev",
  "description": "A deliberately loud demo skin — neo-brutalist borders, hard offset shadows, tilted cards, and animated rainbow gradients. Great for showing the theme system off.",
  "author": "Justflows Team",
  "license": "GPL-2.0-or-later",
  "cssVariables": {
    "--color-primary": "#ff0080",
    "--color-primary-hover": "#d500f9",
    "--color-bg": "#fffef7",
    "--color-surface": "#ffffff",
    "--color-text": "#111111",
    "--color-muted": "#6b6b6b",
    "--color-border": "#111111",
    "--max-width": "720px",
    "--max-width-wide": "1140px"
  },
  "styles": ["styles/global.css"],
  "patterns": {
    "home": "./patterns/home.json",
    "about": "./patterns/about.json",
    "contact": "./patterns/contact.json",
    "post": "./patterns/post.json"
  },
  "demo": {
    "home": "./demo/home.json",
    "blog": "./demo/blog.json",
    "header": "./demo/header.json",
    "footer": "./demo/footer.json"
  },
  "supports": {
    "blockEditor": true,
    "customColors": true,
    "customFonts": true,
    "patterns": true
  },
  "customize": {
    "funky": {
      "label": "Funky",
      "controls": {
        "--jf-rainbow": {
          "label": "Rainbow gradient",
          "type": "select",
          "default": "linear-gradient(90deg, var(--color-primary), var(--jf-orange), var(--jf-yellow), var(--jf-green), var(--jf-cyan), var(--jf-purple), var(--color-primary))",
          "description": "The gradient behind the hero heading, header/footer strips, and submit button.",
          "options": [
            {
              "label": "Accent colours",
              "value": "linear-gradient(90deg, var(--color-primary), var(--jf-orange), var(--jf-yellow), var(--jf-green), var(--jf-cyan), var(--jf-purple), var(--color-primary))"
            },
            {
              "label": "Sunset",
              "value": "linear-gradient(90deg, #ff0080, #ff8c00, #ffd200, #ff8c00, #ff0080)"
            },
            {
              "label": "Ocean",
              "value": "linear-gradient(90deg, #00b0ff, #00e5ff, #00c853, #00b0ff)"
            },
            {
              "label": "Neon",
              "value": "linear-gradient(90deg, #d500f9, #00e5ff, #76ff03, #d500f9)"
            },
            {
              "label": "Candy",
              "value": "linear-gradient(90deg, #ff4ecd, #ffb3f0, #b18bff, #ff4ecd)"
            },
            {
              "label": "Fire",
              "value": "linear-gradient(90deg, #ff2d00, #ff8c00, #ffd200, #ff2d00)"
            },
            {
              "label": "Mono (primary only)",
              "value": "linear-gradient(90deg, var(--color-primary), var(--color-primary))"
            }
          ]
        },
        "--jf-anim": {
          "label": "Rainbow animation",
          "type": "select",
          "default": "jf-funk-slide 5s linear infinite",
          "description": "How the rainbow gradient moves.",
          "options": [
            { "label": "Slide", "value": "jf-funk-slide 5s linear infinite" },
            { "label": "Slide — slow", "value": "jf-funk-slide 12s linear infinite" },
            { "label": "Slide — fast", "value": "jf-funk-slide 2s linear infinite" },
            { "label": "Off", "value": "none" }
          ]
        },
        "--jf-cyan": { "label": "Accent — cyan", "type": "color", "default": "#00b0ff" },
        "--jf-green": { "label": "Accent — green", "type": "color", "default": "#00c853" },
        "--jf-purple": { "label": "Accent — purple", "type": "color", "default": "#d500f9" },
        "--jf-yellow": { "label": "Accent — yellow", "type": "color", "default": "#ffee00" },
        "--jf-orange": { "label": "Accent — orange", "type": "color", "default": "#ff8c00" },
        "--jf-shadow-offset": {
          "label": "Shadow offset",
          "type": "range",
          "default": 8,
          "min": 0,
          "max": 16,
          "step": 1,
          "unit": "px",
          "description": "How far the hard drop-shadows sit behind cards and buttons. 0 = flat."
        },
        "--jf-tilt": {
          "label": "Card tilt",
          "type": "range",
          "default": 1.2,
          "min": 0,
          "max": 5,
          "step": 0.1,
          "unit": "deg",
          "description": "Rotation on comment cards, testimonials, price cards. 0 = straight."
        },
        "--jf-anim-speed": {
          "label": "Backdrop spin speed",
          "type": "range",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.1,
          "unit": "",
          "description": "Speed of the rotating rainbow disc behind the hero and CTA. 0 = freeze."
        },
        "--jf-border-style": {
          "label": "Border style",
          "type": "select",
          "default": "solid",
          "description": "Line style for every box border — cards, form fields, buttons, the comments panel.",
          "options": [
            { "label": "Solid", "value": "solid" },
            { "label": "Dashed", "value": "dashed" },
            { "label": "Dotted", "value": "dotted" },
            { "label": "Double", "value": "double" }
          ]
        }
      }
    }
  },
  "blockControls": {
    "core.hero": ["--jf-rainbow", "--jf-anim", "--jf-tilt"],
    "core.cta": ["--jf-rainbow", "--jf-anim"],
    "core.features": ["--jf-tilt", "--jf-shadow-offset"],
    "core.section": ["--jf-border-style", "--jf-shadow-offset"],
    "core.color-scheme": [
      "--jf-color-scheme-active-bg",
      "--jf-color-scheme-active-fg",
      "--jf-color-scheme-hover-bg",
      "--jf-color-scheme-hover-fg",
      "--jf-color-scheme-hover-border"
    ]
  }
}
