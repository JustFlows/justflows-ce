          { "icon": "🧪", "title": "Pure demo skin", "description": "Every rule lives in one theme stylesheet — nothing here touches the core layout." },
          { "icon": "🧱", "title": "Block builder", "description": "The exact same sections, columns, heroes, and CTAs — just wearing neon." },
          { "icon": "🎨", "title": "Theme customizer", "description": "Repaint it from the admin; the Customizer palette overrides the theme's :root." },
          { "icon": "🌈", "title": "Animated everything", "description": "Spinning conic gradients, sliding rainbows, wiggling buttons. On brand." },
          { "icon": "💬", "title": "Loud comments", "description": "The comment thread ships its own deliberately over-the-top skin." },
          { "icon": "🔁", "title": "One swap back", "description": "Pick Default in the theme picker and the whole site calms down instantly." }
        ]
      }
