{
  "name": "@justflows/installer",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@justflows/core": "file:../core",
    "@justflows/auth": "file:../auth",
    "@justflows/sdk": "file:../sdk",
    "tar": "^7.5.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/tar": "^6.1.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
