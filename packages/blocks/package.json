{
  "name": "@justflows/blocks",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm typecheck:tests",
    "clean": "rm -rf dist",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@justflows/sdk": "workspace:*",
    "katex": "^0.19.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
