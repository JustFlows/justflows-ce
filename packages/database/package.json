{
  "name": "@justflows/database",
  "version": "0.1.4",
  "private": true,
  "description": "Justflows database — SQL adapters, schema, migrations, query helpers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "db:migrate": "node --import tsx/esm scripts/migrate.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@justflows/core": "file:../core",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.24.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
